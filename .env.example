# Authentication.
#
# Easiest: run `yandex-webmaster-mcp auth` (no env needed) to sign in with your
# Yandex account via the built-in public OAuth client. The token is cached at
# ~/.config/yandex-webmaster-mcp/token.json and a cached login takes precedence
# over the variables below.
#
# Static token (e.g. for CI): get one for an app with the `webmaster:hostinfo`
# scope at https://oauth.yandex.ru and put it here.
YANDEX_WEBMASTER_TOKEN=

# Own OAuth app (optional): override the built-in client. Add the secret to also
# enable automatic token refresh. The app needs the `webmaster:hostinfo` and
# `webmaster:verify` scopes.
# YANDEX_OAUTH_CLIENT_ID=
# YANDEX_OAUTH_CLIENT_SECRET=

# Default host id (optional). When set, tools may omit `hostId`.
# Format is the Webmaster host id, e.g. https:example.com:443
# YANDEX_WEBMASTER_HOST_ID=

# Override the token cache location (optional).
# YANDEX_WEBMASTER_TOKEN_FILE=

# API / OAuth base URLs (optional, only override for testing/mocking).
# YANDEX_WEBMASTER_BASE_URL=https://api.webmaster.yandex.net
# YANDEX_OAUTH_BASE_URL=https://oauth.yandex.ru
